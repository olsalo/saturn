{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"], "~/*": ["src/*"], "@coss/ui/lib/*": ["src/lib/*"], "@coss/ui/components/*": ["src/components/ui/*"] },
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
