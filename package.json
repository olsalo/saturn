{
  "name": "saturn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run src",
    "tauri": "tauri",
    "icons": "node scripts/generate-icons.mjs",
    "desktop": "node scripts/desktop.mjs",
    "package": "tauri build",
    "check": "npm run build && npm test && npm run test:launcher",
    "format": "prettier --write src docs README.md package.json tsconfig.json vite.config.ts index.html",
    "test:native": "bash scripts/verify-native.sh",
    "test:shortcut": "bash scripts/verify-shortcut.sh",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/desktop.mjs --rebuild",
    "desktop:repair": "node scripts/desktop.mjs --repair-permissions",
    "test:launcher": "node --test scripts/desktop-permissions.test.mjs",
    "setup:encoder": "node scripts/prepare-ffmpeg.mjs",
    "test:compact": "bash scripts/verify-compact.sh",
    "showcase": "vite --host 127.0.0.1 --port 1421 --open /showcase.html",
    "test:web": "bash scripts/verify-web.sh",
    "wallpapers:thumbs": "node scripts/generate-wallpaper-thumbs.mjs"
  },
  "dependencies": {
    "@base-ui/react": "latest",
    "@tauri-apps/api": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "i18next": "latest",
    "lucide-react": "latest",
    "pixelarticons": "latest",
    "react": "latest",
    "react-day-picker": "latest",
    "react-dom": "latest",
    "react-i18next": "latest",
    "tailwind-merge": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@tauri-apps/cli": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "prettier": "latest",
    "tailwindcss": "latest",
    "tw-animate-css": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
