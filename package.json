{
  "name": "saturn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run src",
    "tauri": "tauri",
    "icons": "node scripts/generate-icons.mjs",
    "desktop": "node scripts/desktop.mjs",
    "package": "tauri build",
    "check": "npm run build && npm test && npm run test:launcher",
    "format": "prettier --write src docs README.md package.json tsconfig.json vite.config.ts index.html",
    "test:native": "bash scripts/verify-native.sh",
    "test:shortcut": "bash scripts/verify-shortcut.sh",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/desktop.mjs --rebuild",
    "desktop:repair": "node scripts/desktop.mjs --repair-permissions",
    "test:launcher": "node --test scripts/desktop-permissions.test.mjs",
    "setup:encoder": "node scripts/prepare-handbrake.mjs && node scripts/prepare-ffmpeg.mjs",
    "test:compact": "bash scripts/verify-compact.sh",
    "showcase": "vite --host 127.0.0.1 --port 1421 --open /showcase.html"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@tauri-apps/api": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^27.0.1",
    "lucide-react": "^0.468.0",
    "pixelarticons": "^2.4.2",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.0",
    "react-i18next": "^18.0.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "~5.9.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
